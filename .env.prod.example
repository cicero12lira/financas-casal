# Copie para .env.prod e preencha. NUNCA commite o .env.prod real.
# Dica: use senhas só com letras/números para não precisar url-encodar na DATABASE_URL.

# ── Banco (Postgres dedicado) ───────────────────────────────
DB_USER=financas_user
DB_PASSWORD=troque_esta_senha
DB_NAME=db_financas
DATABASE_URL=postgresql+psycopg://financas_user:troque_esta_senha@financas_postgres:5432/db_financas

# ── Segurança (JWT) ─────────────────────────────────────────
# Gere com: openssl rand -hex 32
SECRET_KEY=troque_por_uma_chave_aleatoria_longa

# ── Porta publicada no host (gestao_nginx aponta para 172.17.0.1:APP_PORT) ──
APP_PORT=8090

# ── Os dois usuários do casal (seed idempotente) ────────────
USUARIO_A_EMAIL=pessoa.a@gmail.com
USUARIO_A_SENHA=senha_da_pessoa_a
USUARIO_A_NOME=Pessoa A
USUARIO_B_EMAIL=pessoa.b@gmail.com
USUARIO_B_SENHA=senha_da_pessoa_b
USUARIO_B_NOME=Pessoa B
